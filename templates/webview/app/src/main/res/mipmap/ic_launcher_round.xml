<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback fuer Geraete vor API 26, die keine adaptive-icons kennen.
     Setzt dieselben zwei Ebenen wie das adaptive Icon uebereinander, damit
     die Icon-Geometrie nur an einer Stelle existiert: im Foreground-Drawable.
     Dessen eigener Rand liefert gleichzeitig den Abstand zum Rand. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
