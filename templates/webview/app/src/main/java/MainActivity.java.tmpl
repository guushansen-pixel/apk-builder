package {{PACKAGE_ID}};

import android.annotation.SuppressLint;
import android.app.Activity;
import android.content.ActivityNotFoundException;
import android.content.Intent;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.view.KeyEvent;
import android.view.ViewGroup;
import android.webkit.WebResourceRequest;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.widget.Toast;

/**
 * Zeigt die unter assets/www mitgelieferte Web-App in einem WebView an.
 * Bewusst ohne androidx: haelt den Build abhaengigkeitsfrei.
 */
public class MainActivity extends Activity {

    private static final String START_URL = "file:///android_asset/www/index.html";

    // Von new-app.ps1 -KeepScreenOn gesetzt: Bildschirm bleibt an, solange
    // die App im Vordergrund ist (Timer, Atem-Sessions, Lern-Apps). Braucht
    // anders als WAKE_LOCK keine Manifest-Berechtigung.
    private static final boolean KEEP_SCREEN_ON = {{KEEP_SCREEN_ON}};

    private WebView webView;

    @SuppressLint("SetJavaScriptEnabled")
    @SuppressWarnings("deprecation")   // setForceDark: ab API 33 ersetzt, aber
                                       // ohne androidx gibt es keinen Ersatz
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        webView = new WebView(this);
        webView.setLayoutParams(new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT));
        setContentView(webView);

        if (KEEP_SCREEN_ON) {
            getWindow().addFlags(
                    android.view.WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        }

        WebSettings settings = webView.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        // Assets unter file:///android_asset bleiben erreichbar; echter
        // Dateisystem- und Content-Provider-Zugriff wird abgeschaltet.
        settings.setAllowFileAccess(false);
        settings.setAllowContentAccess(false);
        settings.setSupportZoom(false);
        settings.setBuiltInZoomControls(false);
        settings.setMediaPlaybackRequiresUserGesture(false);

        // Zweite Haelfte der Force-Dark-Abschaltung (siehe AppTheme): das
        // System darf die Seite nicht selbst invertieren, sie bringt ihre
        // eigenen hellen und dunklen Farben mit.
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            settings.setForceDark(WebSettings.FORCE_DARK_OFF);
        }

        webView.setWebViewClient(new LocalWebViewClient());

        registerBackGesture();
        registerInsets();

        // restoreState liefert null, wenn kein WebView-Zustand im Bundle
        // liegt (z.B. nach einem Renderer-Absturz, siehe
        // onRenderProcessGone) - dann frisch laden statt leer zu bleiben.
        if (savedInstanceState == null
                || webView.restoreState(savedInstanceState) == null) {
            webView.loadUrl(START_URL);
        }
    }

    // Gesetzt, sobald der Renderer-Prozess des WebView gestorben ist: der
    // WebView ist dann zerstoert und darf bis zum Neuaufbau der Activity
    // nicht mehr angefasst werden.
    private boolean rendererGone = false;

    @Override
    protected void onSaveInstanceState(Bundle outState) {
        super.onSaveInstanceState(outState);
        if (!rendererGone) {
            webView.saveState(outState);
        }
    }

    @Override
    public boolean onKeyDown(int keyCode, KeyEvent event) {
        if (rendererGone) {
            return super.onKeyDown(keyCode, event);
        }
        if (keyCode == KeyEvent.KEYCODE_BACK && webView.canGoBack()) {
            webView.goBack();
            return true;
        }
        return super.onKeyDown(keyCode, event);
    }

    /**
     * Zurueck-Wischgeste (Predictive Back). Ab targetSdk 36 laeuft die
     * Kanten-Geste nicht mehr ueber onKeyDown, sondern nur noch ueber
     * OnBackInvokedCallback - ohne diesen Callback schliesst sie die App
     * direkt, und eine Web-App kann per history.pushState/popstate nichts
     * mehr abfangen (z.B. keine Abbrechen-Rueckfrage mitten in einer
     * Session). Gleiche Logik wie onKeyDown.
     *
     * Klassen voll qualifiziert statt importiert und bewusst OHNE
     * android:enableOnBackInvokedCallback im Manifest: die projekteigenen
     * build.ps1-Wrapper (ice-breath, breathe-well, vokabeltrainer,
     * ladein2) patchen genau diese beiden Stellen selbst nach. Ein doppeltes
     * Manifest-Attribut braeche den Build. Bei targetSdk 36 ist Predictive
     * Back ohnehin Standard; bei niedrigerem targetSdk ignoriert Android den
     * Callback und schickt die Geste wie frueher an onKeyDown.
     */
    private void registerBackGesture() {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
            return;
        }
        getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
                android.window.OnBackInvokedDispatcher.PRIORITY_DEFAULT,
                () -> {
                    if (!rendererGone && webView.canGoBack()) {
                        webView.goBack();
                    } else {
                        finish();
                    }
                });
    }

    // Hoehe von Status- und Navigationsleiste in dp (CSS-px == dp im WebView).
    private volatile int insetTop = 0;
    private volatile int insetBottom = 0;

    /**
     * Edge-to-Edge. Ab targetSdk 35 zeichnet Android auf Android-15+-Geraeten
     * die App hinter Status- und Navigationsleiste; eine klebende Kopf- oder
     * Fusszeile liegt dann unter der Leiste und ist nicht mehr antippbar.
     * env(safe-area-inset-*) liefert im WebView 0, deshalb setzt die
     * Activity die Leistenhoehen selbst als CSS-Variablen --sat / --sab auf
     * document.documentElement - nach jedem Seitenladen und bei jeder
     * Insets-Aenderung (Drehung, Wechsel der Navigationsart). Die Web-App
     * braucht nur var(--sat) / var(--sab) im CSS, mit
     * :root { --sat: env(safe-area-inset-top, 0px); ... } als Rueckfall fuer
     * den Desktop-Browser. Zusaetzlich abfragbar per
     * window.AndroidUi.insetTop() / insetBottom().
     *
     * Ohne erzwungenes Edge-to-Edge (aelteres Geraet oder targetSdk < 35)
     * liegt der Inhalt ohnehin zwischen den Leisten, dann bleiben beide 0.
     */
    private void registerInsets() {
        webView.addJavascriptInterface(new InsetsBridge(), "AndroidUi");
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.VANILLA_ICE_CREAM) {
            return;
        }
        if (getApplicationInfo().targetSdkVersion < Build.VERSION_CODES.VANILLA_ICE_CREAM) {
            return;
        }
        getWindow().getDecorView().setOnApplyWindowInsetsListener((v, insets) -> {
            android.graphics.Insets bars =
                    insets.getInsets(android.view.WindowInsets.Type.systemBars());
            float density = getResources().getDisplayMetrics().density;
            if (density <= 0) {
                density = 1;
            }
            insetTop = Math.round(bars.top / density);
            insetBottom = Math.round(bars.bottom / density);
            pushInsets();
            return v.onApplyWindowInsets(insets);
        });
    }

    private void pushInsets() {
        if (rendererGone) {
            return;
        }
        webView.evaluateJavascript(
                "(function(s){s.setProperty('--sat','" + insetTop + "px');"
                        + "s.setProperty('--sab','" + insetBottom + "px');})"
                        + "(document.documentElement.style)", null);
    }

    private class InsetsBridge {
        @android.webkit.JavascriptInterface
        public int insetTop() { return insetTop; }

        @android.webkit.JavascriptInterface
        public int insetBottom() { return insetBottom; }
    }

    /** Haelt lokale Seiten im WebView, externe Links gehen an den Browser. */
    private class LocalWebViewClient extends WebViewClient {

        @Override
        public void onPageFinished(WebView view, String url) {
            pushInsets();
        }

        /**
         * Der Renderer-Prozess des WebView ist gestorben (Absturz oder vom
         * System bei Speichermangel beendet). Ohne diese Methode beendet
         * Android daraufhin die ganze App. Stattdessen: toten WebView
         * entfernen und die Activity neu aufbauen - onCreate legt dann einen
         * frischen WebView an, samt allem, was die build.ps1-Wrapper dort
         * einhaengen (JS-Bruecken), und laedt die Startseite. Was die Web-App
         * im localStorage gesichert hat, ist danach wieder da. Aufgerufen
         * wird das erst ab Android 8 (API 26); darunter bleibt es beim alten
         * Verhalten.
         */
        @Override
        public boolean onRenderProcessGone(WebView view,
                android.webkit.RenderProcessGoneDetail detail) {
            rendererGone = true;
            ViewGroup parent = (ViewGroup) view.getParent();
            if (parent != null) {
                parent.removeView(view);
            }
            view.destroy();
            recreate();
            return true;
        }

        @Override
        public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
            Uri uri = request.getUrl();
            String scheme = uri.getScheme();
            if (scheme == null || scheme.equals("file")) {
                return false;
            }
            try {
                Intent intent = new Intent(Intent.ACTION_VIEW, uri);
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                startActivity(intent);
            } catch (ActivityNotFoundException e) {
                Toast.makeText(MainActivity.this,
                        "Keine App fuer diesen Link gefunden",
                        Toast.LENGTH_SHORT).show();
            }
            return true;
        }
    }
}
