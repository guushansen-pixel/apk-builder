package {{PACKAGE_ID}};

import android.annotation.SuppressLint;
import android.app.Activity;
import android.content.ActivityNotFoundException;
import android.content.Intent;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.view.KeyEvent;
import android.view.ViewGroup;
import android.webkit.WebResourceRequest;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.widget.Toast;

/**
 * Zeigt die unter assets/www mitgelieferte Web-App in einem WebView an.
 * Bewusst ohne androidx: haelt den Build abhaengigkeitsfrei.
 */
public class MainActivity extends Activity {

    private static final String START_URL = "file:///android_asset/www/index.html";

    // Von new-app.ps1 -KeepScreenOn gesetzt: Bildschirm bleibt an, solange
    // die App im Vordergrund ist (Timer, Atem-Sessions, Lern-Apps). Braucht
    // anders als WAKE_LOCK keine Manifest-Berechtigung.
    private static final boolean KEEP_SCREEN_ON = {{KEEP_SCREEN_ON}};

    private WebView webView;

    @SuppressLint("SetJavaScriptEnabled")
    @SuppressWarnings("deprecation")   // setForceDark: ab API 33 ersetzt, aber
                                       // ohne androidx gibt es keinen Ersatz
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        webView = new WebView(this);
        webView.setLayoutParams(new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT));
        setContentView(webView);

        if (KEEP_SCREEN_ON) {
            getWindow().addFlags(
                    android.view.WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        }

        WebSettings settings = webView.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        // Assets unter file:///android_asset bleiben erreichbar; echter
        // Dateisystem- und Content-Provider-Zugriff wird abgeschaltet.
        settings.setAllowFileAccess(false);
        settings.setAllowContentAccess(false);
        settings.setSupportZoom(false);
        settings.setBuiltInZoomControls(false);
        settings.setMediaPlaybackRequiresUserGesture(false);

        // Zweite Haelfte der Force-Dark-Abschaltung (siehe AppTheme): das
        // System darf die Seite nicht selbst invertieren, sie bringt ihre
        // eigenen hellen und dunklen Farben mit.
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            settings.setForceDark(WebSettings.FORCE_DARK_OFF);
        }

        webView.setWebViewClient(new LocalWebViewClient());

        registerBackGesture();

        if (savedInstanceState != null) {
            webView.restoreState(savedInstanceState);
        } else {
            webView.loadUrl(START_URL);
        }
    }

    @Override
    protected void onSaveInstanceState(Bundle outState) {
        super.onSaveInstanceState(outState);
        webView.saveState(outState);
    }

    @Override
    public boolean onKeyDown(int keyCode, KeyEvent event) {
        if (keyCode == KeyEvent.KEYCODE_BACK && webView.canGoBack()) {
            webView.goBack();
            return true;
        }
        return super.onKeyDown(keyCode, event);
    }

    /**
     * Zurueck-Wischgeste (Predictive Back). Ab targetSdk 36 laeuft die
     * Kanten-Geste nicht mehr ueber onKeyDown, sondern nur noch ueber
     * OnBackInvokedCallback - ohne diesen Callback schliesst sie die App
     * direkt, und eine Web-App kann per history.pushState/popstate nichts
     * mehr abfangen (z.B. keine Abbrechen-Rueckfrage mitten in einer
     * Session). Gleiche Logik wie onKeyDown.
     *
     * Klassen voll qualifiziert statt importiert und bewusst OHNE
     * android:enableOnBackInvokedCallback im Manifest: die projekteigenen
     * build.ps1-Wrapper (ice-breath, breathe-well, vokabeltrainer,
     * ladein2) patchen genau diese beiden Stellen selbst nach. Ein doppeltes
     * Manifest-Attribut braeche den Build. Bei targetSdk 36 ist Predictive
     * Back ohnehin Standard; bei niedrigerem targetSdk ignoriert Android den
     * Callback und schickt die Geste wie frueher an onKeyDown.
     */
    private void registerBackGesture() {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
            return;
        }
        getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
                android.window.OnBackInvokedDispatcher.PRIORITY_DEFAULT,
                () -> {
                    if (webView.canGoBack()) {
                        webView.goBack();
                    } else {
                        finish();
                    }
                });
    }

    /** Haelt lokale Seiten im WebView, externe Links gehen an den Browser. */
    private class LocalWebViewClient extends WebViewClient {

        @Override
        public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
            Uri uri = request.getUrl();
            String scheme = uri.getScheme();
            if (scheme == null || scheme.equals("file")) {
                return false;
            }
            try {
                Intent intent = new Intent(Intent.ACTION_VIEW, uri);
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                startActivity(intent);
            } catch (ActivityNotFoundException e) {
                Toast.makeText(MainActivity.this,
                        "Keine App fuer diesen Link gefunden",
                        Toast.LENGTH_SHORT).show();
            }
            return true;
        }
    }
}
